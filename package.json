{
  "name": "gate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run start:api\" \"npm run dev --workspace frontend\"",
    "start": "npm run start:api",
    "start:api": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "test:email": "npm run test:email --workspace backend",
    "provision:admin": "npm run provision:admin --workspace backend",
    "migrate:local-data-to-mongodb": "npm run migrate:local-data-to-mongodb --workspace backend",
    "reset:admin-password": "npm run reset:admin-password --workspace backend",
    "rotate:admin-credentials": "npm run rotate:admin-credentials --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
