MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=<database-name>
PORT=5000
APP_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Additional exact HTTP(S) origins, comma-separated. Set the current Netlify deploy-preview
# origin here in Render; do not use wildcards. The production Netlify origin is always allowed.
CORS_ALLOWED_ORIGINS=
# Netlify production builds use this Render API origin. Local Vite uses its /api proxy.
VITE_API_BASE_URL=https://kinetiqacademi.onrender.com
JWT_SECRET=<generate-a-long-random-secret>
# Used by the existing email notification service. Configure real values only in an untracked local .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp-username>
SMTP_PASS=<google-generated-app-password>
EMAIL_FROM=<sender-email>
ADMIN_BOOTSTRAP_NAME=<admin-name>
ADMIN_BOOTSTRAP_EMAIL=<admin-email>
ADMIN_BOOTSTRAP_PASSWORD=<12-72-character-admin-password>
# Only set these in the local shell when explicitly resetting an existing admin.
ADMIN_RESET_EMAIL=<existing-admin-email>
ADMIN_RESET_CONFIRM=<repeat-existing-admin-email>
ADMIN_RESET_PASSWORD=<new-12-72-byte-password>
ADMIN_RESET_TARGET_CONFIRM=<type-NON-PRODUCTION-after-checking-target>
# Used by the existing administrator mobile OTP and student registration OTP flows only.
# Existing adapter sends POST JSON { phone, code, name } and uses Bearer OTP_DELIVERY_TOKEN.
# Set these only to a provider/webhook whose documented API matches that contract.
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
# Student mobile login uses MSG91's provider-managed OTP flow.
# Get both values from the MSG91 OTP section; configure an active, approved template that supports OTP.
MSG91_AUTH_KEY=<msg91-auth-key>
MSG91_TEMPLATE_ID=<msg91-otp-template-id>